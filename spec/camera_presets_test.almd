import self as cp

local fn near(a: Float, b: Float) -> Bool = {
  let d = a - b
  if d < 0.0 then (0.0 - d) < 0.0001 else d < 0.0001
}

// デモアンカー: head=(0,1.4,0), hips=(0,0.9,0), forward=(0,0,1)
local fn face(ch: Int) -> Float = cp.cam(0, ch, 0.0, 1.4, 0.0, 0.0, 0.9, 0.0, 0.0, 0.0, 1.0)
local fn upper(ch: Int) -> Float = cp.cam(1, ch, 0.0, 1.4, 0.0, 0.0, 0.9, 0.0, 0.0, 0.0, 1.0)
local fn full(ch: Int) -> Float = cp.cam(2, ch, 0.0, 1.4, 0.0, 0.0, 0.9, 0.0, 0.0, 0.0, 1.0)

test "ease is in-out cubic: 0/0.5/1" {
  assert(near(cp.ease(0.0), 0.0))
  assert(near(cp.ease(0.5), 0.5))
  assert(near(cp.ease(1.0), 1.0))
  assert(cp.ease(0.25) < 0.25)   // ease-in 前半は遅い
}

test "lerp" {
  assert(near(cp.lerp(0.0, 10.0, 0.0), 0.0))
  assert(near(cp.lerp(0.0, 10.0, 0.5), 5.0))
  assert(near(cp.lerp(0.0, 10.0, 1.0), 10.0))
}

test "face: pos = head + fwd*0.55, look = head" {
  assert(near(face(0), 0.0))    // pos_x
  assert(near(face(1), 1.4))    // pos_y
  assert(near(face(2), 0.55))   // pos_z = hz + fz*0.55
  assert(near(face(3), 0.0))    // look_x = head.x
  assert(near(face(4), 1.4))    // look_y = head.y
  assert(near(face(5), 0.0))    // look_z = head.z
}

test "upper: pos y pinned to head.y-0.15, look y = head.y-0.2" {
  assert(near(upper(0), 0.0))    // pos_x
  assert(near(upper(1), 1.25))   // pos_y = 1.4 - 0.15
  assert(near(upper(2), 1.4))    // pos_z = hz + fz*1.4
  assert(near(upper(4), 1.2))    // look_y = 1.4 - 0.2
}

test "full: anchored on hips, pos y = hips.y+0.05" {
  assert(near(full(1), 0.95))   // pos_y = 0.9 + 0.05
  assert(near(full(2), 2.6))    // pos_z = ipz + fz*2.6
  assert(near(full(3), 0.0))    // look = hips
  assert(near(full(4), 0.9))    // look_y = hips.y
}
